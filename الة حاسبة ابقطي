    function renderHeadlineFigures(data) {
      const figEasterC = document.getElementById(`fig-easter-coptic`);
      const figEasterG = document.getElementById(`fig-easter-greg`);
      const figEasterM = document.getElementById(`fig-easter-meta`);
      if (figEasterC) figEasterC.textContent = `الأحد ${formatCopticDate(data.easterCoptic)}`;
      if (figEasterG) figEasterG.textContent = `الموافق ${formatGregDate(data.easterGreg)}`;
      if (figEasterM) figEasterM.textContent = `انقضى من ${COPTIC_MONTHS[data.easterCoptic.month - 1]}: ${toEastern(data.easterCoptic.day)} يوماً`;

      const figNyC = document.getElementById(`fig-ny-coptic`);
      const figNyG = document.getElementById(`fig-ny-greg`);
      const figNyL = document.getElementById(`fig-ny-leap`);
      if (figNyC) figNyC.textContent = `${data.startDayName} ١ توت ${toEastern(data.yc)} ش`;
      if (figNyG) figNyG.textContent = `الموافق ${formatGregDate(data.nyGreg)}`;
      if (figNyL) {
        figNyL.textContent = data.isCopticLeapYear
          ? `سنة كبيسة إضافية (النسئ ٦ أيام — ٣٦٦ يوماً)`
          : `سنة بسيطة قبطية (النسئ ٥ أيام — ٣٦٥ يوماً)`;
      }

      const passGreg = jdnToGregorian(data.passoverJdn);
      const figPasC = document.getElementById(`fig-passover-coptic`);
      const figPasG = document.getElementById(`fig-passover-greg`);
      const figPasM = document.getElementById(`fig-passover-meta`);
      if (figPasC) figPasC.textContent = `${WEEKDAYS[data.passoverWd]} ${toEastern(data.passoverDay)} ${COPTIC_MONTHS[data.passoverMonth - 1]}`;
      if (figPasG) figPasG.textContent = `الموافق ${formatGregDate(passGreg)}`;
      if (figPasM) figPasM.textContent = `دور القمر: ${toEastern(data.moonCycle)} • أبقطي القمر: ${toEastern(data.moonEpact)}`;

      const lentStartC = jdnToCoptic(data.movable.lentStartJdn);
      const lentStartG = jdnToGregorian(data.movable.lentStartJdn);
      const figLentC = document.getElementById(`fig-lent-coptic`);
      const figLentG = document.getElementById(`fig-lent-greg`);
      const figAposM = document.getElementById(`fig-apostles-meta`);
      if (figLentC) figLentC.textContent = `الإثنين ${formatCopticShort(lentStartC)}`;
      if (figLentG) figLentG.textContent = `الموافق ${formatGregDate(lentStartG)} (رفاع الميلاد: ${toEastern(data.rifaNativityDays)} يوماً)`;
      if (figAposM) figAposM.textContent = `مدة صوم الآباء الرسل: ${toEastern(data.apostlesFastDays)} يوماً`;
    }

    function renderSteps(data) {
      // Badges
      const bSun = document.getElementById(`badge-sun-epact`);
      const bMoon = document.getElementById(`badge-moon-epact`);
      const bPas = document.getElementById(`badge-passover-rule`);
      const bEas = document.getElementById(`badge-easter-day`);
      const bDer = document.getElementById(`badge-derived`);

      if (bSun) bSun.textContent = `أبقطي الشمس = ${toEastern(data.sunEpact)}`;
      if (bMoon) bMoon.textContent = `أبقطي القمر = ${toEastern(data.moonEpact)}`;
      if (bPas) bPas.textContent = `${toEastern(data.passoverDay)} ${COPTIC_MONTHS[data.passoverMonth - 1]}`;
      if (bEas) bEas.textContent = `${toEastern(data.easterCoptic.day)} ${COPTIC_MONTHS[data.easterCoptic.month - 1]}`;
      if (bDer) bDer.textContent = `${toEastern(data.yc)} ش / ${toEastern(data.gregEasterYear)} م`;

      // Step 1
      const s1 = document.getElementById(`step1-equations`);
      if (s1) {
        const divSun = Math.floor(data.sunMinus4 / 28);
        const remSunText = (data.sunMinus4 % 28 === 0) ? `٠ (نأخذ ٢٨ كاملاً)` : toEastern(data.sunCycle);
        const weeks7 = Math.floor(data.sunSum / 7);
        const rem7Text = (data.sunSum % 7 === 0) ? `٠ (نأخذ ٧ كاملاً)` : toEastern(data.sunEpact);
        s1.innerHTML = `
          <div class="eq-line"><span class="eq-formula">١. نطرح ٤ من سنة الشهداء: ${toEastern(data.yc)} − ٤</span><span class="eq-result">= ${toEastern(data.sunMinus4)}</span></div>
          <div class="eq-line"><span class="eq-formula">٢. نقسم على ٢٨ (دور الشمس): ${toEastern(data.sunMinus4)} ÷ ٢٨ = ${toEastern(divSun)} والباقي</span><span class="eq-result">دور الشمس = ${remSunText}</span></div>
          <div class="eq-line"><span class="eq-formula">٣. نضيف ربع دور الشمس بلا كسور: ${toEastern(data.sunCycle)} + ${toEastern(data.sunQuarter)}</span><span class="eq-result">= ${toEastern(data.sunSum)}</span></div>
          <div class="eq-line"><span class="eq-formula">٤. نسقط الأسابيع الكاملة (٧ × ${toEastern(weeks7)} = ${toEastern(weeks7 * 7)}): الباقي</span><span class="eq-result">أبقطي الشمس = ${rem7Text} ← ${data.startDayName}</span></div>
        `;
      }

      const strip = document.getElementById(`sun-epact-strip`);
      if (strip) {
        strip.innerHTML = SUN_EPACT_DAYS.map(function (item) {
          const activeClass = item.epact === data.sunEpact ? ` is-active` : ``;
          return `<div class="epact-cell${activeClass}"><span class="epact-cell-num">${toEastern(item.epact)}</span><span>${item.name}</span></div>`;
        }).join(``);
      }

      // Step 2
      const s2 = document.getElementById(`step2-equations`);
      if (s2) {
        const divMoonC = Math.floor(data.moonMinus1 / 19);
        const divMoonG = Math.floor(data.gregEasterYear / 19);
        const months30 = Math.floor(data.moonTimes11 / 30);
        s2.innerHTML = `
          <div class="eq-line"><span class="eq-formula">أ. بسنة الشهداء: (${toEastern(data.yc)} − ١) ÷ ١٩ = ${toEastern(data.moonMinus1)} ÷ ١٩ (${toEastern(divMoonC)} دورة والباقي)</span><span class="eq-result">دور القمر = ${toEastern(data.moonCycle)}</span></div>
          <div class="eq-line"><span class="eq-formula">ب. بالسنة الميلادية: ${toEastern(data.gregEasterYear)} ÷ ١٩ (${toEastern(divMoonG)} دورة والباقي)</span><span class="eq-result">دور القمر = ${toEastern(data.moonCycleGreg)}</span></div>
          <div class="eq-line"><span class="eq-formula">ج. نضرب دور القمر × ١١ (فارق الشمسية والقمرية): ${toEastern(data.moonCycle)} × ١١</span><span class="eq-result">= ${toEastern(data.moonTimes11)} يوماً</span></div>
          <div class="eq-line"><span class="eq-formula">د. نسقط الشهور التامة (${toEastern(months30)} × ٣٠ = ${toEastern(months30 * 30)}): الباقي</span><span class="eq-result">أبقطي القمر = ${toEastern(data.moonEpact)}</span></div>
        `;
      }

      // Step 3
      const s3 = document.getElementById(`step3-equations`);
      const s3Note = document.getElementById(`step3-note`);
      if (s3) {
        let extraLine = ``;
        if (data.moonCycle === 19) {
          extraLine = `<div class="eq-line"><span class="eq-formula">٢. تعديل السنة التاسعة عشرة (قفزة القمر): نسقط يوماً إضافياً لتوافق ١١ − ١</span><span class="eq-result">١٠ برمودة</span></div>`;
        } else if (data.rawSub > 30) {
          extraLine = `<div class="eq-line"><span class="eq-formula">٢. زاد الناتج عن ٣٠ فنطرح شهراً كاملاً: ${toEastern(data.rawSub)} − ٣٠</span><span class="eq-result">${toEastern(data.passoverDay)} برمودة</span></div>`;
        } else {
          const monthRule = data.passoverMonth === 7 ? `يقع بين ٢٥ و٣٠ ← في شهر برمهات` : `يقع بين ١ و٢٣ ← في شهر برمودة`;
          extraLine = `<div class="eq-line"><span class="eq-formula">٢. تصنيف الشهر (${monthRule})</span><span class="eq-result">${toEastern(data.passoverDay)} ${COPTIC_MONTHS[data.passoverMonth - 1]}</span></div>`;
        }
        s3.innerHTML = `
          <div class="eq-line"><span class="eq-formula">١. القاعدة الثابتة (نطرح أبقطي القمر من ٤٠): ٤٠ − ${toEastern(data.moonEpact)}</span><span class="eq-result">= ${toEastern(data.rawSub)}</span></div>
          ${extraLine}
          <div class="eq-line"><span class="eq-formula">٣. اليوم الأسبوعي لـ ${toEastern(data.passoverDay)} ${COPTIC_MONTHS[data.passoverMonth - 1]}</span><span class="eq-result">${WEEKDAYS[data.passoverWd]}</span></div>
        `;
      }
      if (s3Note) {
        s3Note.textContent = `إذا وقع ناتج القاعدة بين ٢٥ و٣٠ يكون ذبح الخروف في برمهات، وإذا وقع بين ١ و٢٣ يكون في برمودة، ولا يأتي ٢٤ مطلقاً. وفي السنة التاسعة عشرة من دور ميتون (أبقطي القمر ٢٩) يكون الموعد ١٠ برمودة طبقاً لجدول الدورة.`;
      }

      // Step 4: Easter Sunday & Calendar Grid
      const s4 = document.getElementById(`step4-equations`);
      if (s4) {
        const sameSundayNote = data.passoverWd === 0
          ? `وافق ذبح الخروف يوم الأحد ذاته؛ لذا نضيف ٧ أيام كاملة ليكون الأحد التالي`
          : `نحسب الأيام المتبقية حتى الأحد التالي (+${toEastern(data.daysAfterPassover)} ${data.daysAfterPassover === 1 ? `يوم` : `أيام`})`;
        s4.innerHTML = `
          <div class="eq-line"><span class="eq-formula">١. يوم ذبح الخروف: ${WEEKDAYS[data.passoverWd]} ${toEastern(data.passoverDay)} ${COPTIC_MONTHS[data.passoverMonth - 1]}</span><span class="eq-result">${sameSundayNote}</span></div>
          <div class="eq-line"><span class="eq-formula">٢. عيد القيامة المجيد</span><span class="eq-result">الأحد ${formatCopticDate(data.easterCoptic)} (${formatGregDate(data.easterGreg)})</span></div>
        `;
      }

      renderEasterMonthCalendar(data);

      // Step 5: Derived Formulas
      const s5 = document.getElementById(`step5-equations`);
      if (s5) {
        const eDay = data.easterCoptic.day;
        const eMonth = data.easterCoptic.month;
        const eMonthName = COPTIC_MONTHS[eMonth - 1];
        const rifaGreat = jdnToCoptic(data.movable.lentRifaJdn);
        const asc = jdnToCoptic(data.movable.ascensionJdn);
        const pent = jdnToCoptic(data.movable.pentecostJdn);
        const remMonth = 30 - eDay;

        const nativityAdd = eMonth === 8 ? 36 : 6;
        const apostlesAdd = eMonth === 8 ? 15 : 45;
        const lentRifaRaw = eDay + 4;
        const lentRifaCalcText = eMonth === 7
          ? (lentRifaRaw > 30 ? `${toEastern(eDay)} + ٤ = ${toEastern(lentRifaRaw)} ← − ٣٠ = ${toEastern(rifaGreat.day)} أمشير` : `${toEastern(eDay)} + ٤ = ${toEastern(rifaGreat.day)} طوبة`)
          : (lentRifaRaw > 30 ? `${toEastern(eDay)} + ٤ = ${toEastern(lentRifaRaw)} ← − ٣٠ = ${toEastern(rifaGreat.day)} برمهات` : `${toEastern(eDay)} + ٤ = ${toEastern(rifaGreat.day)} أمشير`);

        const ascRaw = eDay + 9;
        const ascCalcText = ascRaw > 30
          ? `${toEastern(eDay)} + ٩ = ${toEastern(ascRaw)} ← − ٣٠ = ${toEastern(asc.day)} ${COPTIC_MONTHS[asc.month - 1]}`
          : `${toEastern(eDay)} + ٩ = ${toEastern(asc.day)} بشنس`;

        const pentRaw = eDay + 19;
        const pentCalcText = pentRaw > 30
          ? `${toEastern(eDay)} + ١٩ = ${toEastern(pentRaw)} ← − ٣٠ = ${toEastern(pent.day)} ${COPTIC_MONTHS[pent.month - 1]}`
          : `${toEastern(eDay)} + ١٩ = ${toEastern(pent.day)} بشنس`;

        s5.innerHTML = `
          <div class="eq-line"><span class="eq-formula">رفاع الميلاد (${eMonthName}): ${toEastern(eDay)} + ${toEastern(nativityAdd)}</span><span class="eq-result">= ${toEastern(data.rifaNativityDays)} يوماً</span></div>
          <div class="eq-line"><span class="eq-formula">أحد رفاع الصوم الكبير: ${lentRifaCalcText}</span><span class="eq-result">${formatCopticShort(rifaGreat)}</span></div>
          <div class="eq-line"><span class="eq-formula">عيد الصعود المجيد: ${ascCalcText}</span><span class="eq-result">${formatCopticShort(asc)}</span></div>
          <div class="eq-line"><span class="eq-formula">عيد العنصرة المجيد: ${pentCalcText}</span><span class="eq-result">${formatCopticShort(pent)}</span></div>
          <div class="eq-line"><span class="eq-formula">عدد أيام صوم الرسل: باقي ${eMonthName} (${toEastern(remMonth)}) + ${toEastern(apostlesAdd)}</span><span class="eq-result">= ${toEastern(data.apostlesFastDays)} يوماً</span></div>
        `;
      }
    }

    function renderEasterMonthCalendar(data) {
      const titleEl = document.getElementById(`easter-cal-title`);
      const gridEl = document.getElementById(`easter-month-grid`);
      if (!gridEl) return;

      // Display the month where Easter occurs (if Passover was in Baramhat and Easter in Parmoute, show Parmoute or note Passover)
      const displayMonth = data.easterCoptic.month;
      const firstOfMonthJdn = copticToJdn(data.yc, displayMonth, 1);
      const firstWd = jdnWeekdayIndex(firstOfMonthJdn);

      if (titleEl) {
        const extra = data.passoverMonth !== displayMonth
          ? ` (ملاحظة: ذبح الخروف كان ${toEastern(data.passoverDay)} برمهات)`
          : ``;
        titleEl.textContent = `تقويم شهر ${COPTIC_MONTHS[displayMonth - 1]} ${toEastern(data.yc)} ش${extra}`;
      }

      let cells = [];
      for (let b = 0; b < firstWd; b++) {
        cells.push(`<div class="cal-day is-empty" aria-hidden="true"></div>`);
      }
      for (let d = 1; d <= 30; d++) {
        const isPassover = (data.passoverMonth === displayMonth && data.passoverDay === d);
        const isEaster = (data.easterCoptic.day === d);
        let cls = `cal-day`;
        let tag = ``;
        if (isEaster) {
          cls += ` is-easter`;
          tag = `<span class="cal-day-tag">القيامة</span>`;
        } else if (isPassover) {
          cls += ` is-passover`;
          tag = `<span class="cal-day-tag">الفصح</span>`;
        }
        cells.push(`<div class="${cls}"><span>${toEastern(d)}</span>${tag}</div>`);
      }
      gridEl.innerHTML = cells.join(``);
    }

    function renderMonthsTable(data) {
      const caption = document.getElementById(`months-table-caption`);
      const tbody = document.getElementById(`coptic-months-tbody`);
      if (caption) caption.textContent = `بداية الشهور القبطية الـ ١٣ لسنة ${toEastern(data.yc)} ش`;
      if (!tbody) return;

      let rows = [];
      for (let m = 1; m <= 13; m++) {
        const jdn = copticToJdn(data.yc, m, 1);
        const wd = jdnWeekdayIndex(jdn);
        const greg = jdnToGregorian(jdn);
        const len = m < 13 ? 30 : (data.isCopticLeapYear ? 6 : 5);
        const highlight = (m === data.easterCoptic.month) ? ` class="is-highlighted"` : ``;
        rows.push(`
          <tr${highlight}>
            <td>${toEastern(m)}</td>
            <td>${COPTIC_MONTHS[m - 1]}</td>
            <td>${toEastern(len)}</td>
            <td>${WEEKDAYS[wd]}</td>
            <td>${formatGregDate(greg)}</td>
          </tr>
        `);
      }
      tbody.innerHTML = rows.join(``);
    }

    function renderMetonicTable(data) {
      const tbody = document.getElementById(`metonic-tbody`);
      if (!tbody) return;
      tbody.innerHTML = METONIC_TABLE.map(function (row) {
        const active = row.cycle === data.moonCycle ? ` class="is-highlighted"` : ``;
        return `
          <tr${active}>
            <td>${toEastern(row.cycle)}</td>
            <td>${toEastern(row.epact)}</td>
            <td>${toEastern(row.passoverDay)} ${COPTIC_MONTHS[row.passoverMonth - 1]}</td>
          </tr>
        `;
      }).join(``);
    }

    function renderMovableSection(data) {
      const caption = document.getElementById(`movable-table-caption`);
      const tbody = document.getElementById(`movable-tbody`);
      if (caption) caption.textContent = `جدول الأصوام والأعياد المتحركة — سنة ${toEastern(data.yc)} ش / ${toEastern(data.gregEasterYear)} م`;

      // Proportion bar (Christmas to 5 Abib = ~190 days total)
      const m = data.movable;
      const totalSpan = m.apostlesFeastJdn - data.xmasJdn;
      const nativityLen = m.lentStartJdn - data.xmasJdn;
      const lentLen = 55;
      const pentecostLen = 50;
      const apostlesLen = data.apostlesFastDays;
      const barEl = document.getElementById(`liturgical-span-bar`);
      const legEl = document.getElementById(`liturgical-span-legend`);

      if (barEl && totalSpan > 0) {
        const pNat = (nativityLen / totalSpan) * 100;
        const pLent = (lentLen / totalSpan) * 100;
        const pPent = (pentecostLen / totalSpan) * 100;
        const pApos = (apostlesLen / totalSpan) * 100;
        barEl.innerHTML = `
          <div class="span-seg seg-nativity" style="width: ${pNat.toFixed(1)}%">رفاع الميلاد (${toEastern(data.rifaNativityDays)})</div>
          <div class="span-seg seg-lent" style="width: ${pLent.toFixed(1)}%">الصوم الكبير (٥٥)</div>
          <div class="span-seg seg-pentecost" style="width: ${pPent.toFixed(1)}%">الخماسين (٥٠)</div>
          <div class="span-seg seg-apostles" style="width: ${pApos.toFixed(1)}%">صوم الرسل (${toEastern(apostlesLen)})</div>
        `;
      }
      if (legEl) {
        legEl.innerHTML = `
          <span class="legend-item"><span class="legend-swatch seg-nativity"></span> رفاع الميلاد: ${toEastern(data.rifaNativityDays)} يوماً</span>
          <span class="legend-item"><span class="legend-swatch seg-lent"></span> الصوم الكبير: ٥٥ يوماً ثابتة</span>
          <span class="legend-item"><span class="legend-swatch seg-pentecost"></span> الخماسين المقدسة: ٥٠ يوماً ثابتة</span>
          <span class="legend-item"><span class="legend-swatch seg-apostles"></span> صوم الرسل: ${toEastern(apostlesLen)} يوماً (يتراوح بين ١٥ و٤٩ يوماً)</span>
        `;
      }

      const items = [
        { name: `أحد رفاع صوم يونان`, jdn: m.jonahRifaJdn, rule: `قبل القيامة بـ ٧٠ يوماً`, major: false },
        { name: `بداية صوم يونان (٣ أيام)`, jdn: m.jonahStartJdn, rule: `قبل القيامة بـ ٦٩ يوماً`, major: false },
        { name: `فصح يونان`, jdn: m.jonahPassoverJdn, rule: `قبل القيامة بـ ٦٦ يوماً`, major: false },
        { name: `أحد رفاع الصوم الكبير`, jdn: m.lentRifaJdn, rule: `قبل القيامة بـ ٥٦ يوماً (تاريخ القيامة + ٤)`, major: false },
        { name: `بداية الصوم الكبير`, jdn: m.lentStartJdn, rule: `قبل القيامة بـ ٥٥ يوماً`, major: false },
        { name: `جمعة ختام الصوم`, jdn: m.lentLastFriJdn, rule: `قبل القيامة بـ ٩ أيام`, major: false },
        { name: `سبت لعازر`, jdn: m.lazarusSatJdn, rule: `قبل القيامة بـ ٨ أيام`, major: false },
        { name: `أحد الشعانين (سيدي كبير)`, jdn: m.palmSunJdn, rule: `قبل القيامة بـ ٧ أيام`, major: true },
        { name: `خميس العهد (سيدي صغير)`, jdn: m.covenantThuJdn, rule: `قبل القيامة بـ ٣ أيام`, major: false },
        { name: `الجمعة العظيمة`, jdn: m.goodFriJdn, rule: `قبل القيامة بيومين`, major: false },
        { name: `سبت النور`, jdn: m.brightSatJdn, rule: `عشية عيد القيامة`, major: false },
        { name: `عيد القيامة المجيد (سيدي كبير)`, jdn: m.easterJdn, rule: `الأحد التالي لذبح الخروف`, major: true },
        { name: `أحد توما (سيدي صغير)`, jdn: m.thomasSunJdn, rule: `الأحد الأول بعد القيامة (+٧ أيام)`, major: false },
        { name: `عيد الصعود المجيد (سيدي كبير)`, jdn: m.ascensionJdn, rule: `اليوم الـ ٤٠ من القيامة (تاريخ القيامة + ٩)`, major: true },
        { name: `عيد العنصرة المجيد (سيدي كبير)`, jdn: m.pentecostJdn, rule: `اليوم الـ ٥٠ من القيامة (تاريخ القيامة + ١٩)`, major: true },
        { name: `بداية صوم الآباء الرسل`, jdn: m.apostlesStartJdn, rule: `الإثنين التالي للعنصرة — مدته ${toEastern(data.apostlesFastDays)} يوماً`, major: false },
        { name: `عيد الآباء الرسل (بطرس وبولس)`, jdn: m.apostlesFeastJdn, rule: `٥ أبيب ثابت (ختام صوم الرسل)`, major: false }
      ];

      if (tbody) {
        tbody.innerHTML = items.map(function (it) {
          const c = jdnToCoptic(it.jdn);
          const g = jdnToGregorian(it.jdn);
          const wd = WEEKDAYS[jdnWeekdayIndex(it.jdn)];
          const rowCls = it.major ? ` class="is-major-feast"` : ``;
          return `
            <tr${rowCls}>
              <td><strong>${it.name}</strong></td>
              <td>${wd}</td>
              <td>${formatCopticDate(c)}</td>
              <td>${formatGregDate(g)}</td>
              <td>${it.rule}</td>
