      if (btnG) btnG.classList.toggle(`active`, mode === `gregorian`);
      if (label) {
        label.textContent = mode === `coptic`
          ? `أدخل سنة الشهداء (من ١ إلى ٣٠٠٠ ش)`
          : `أدخل السنة الميلادية لعيد القيامة (من ٢٨٥ إلى ٣٢٨٤ م)`;
      }
      normalizeYearInputDisplay();
      saveStateSafe();
