    function normalizeYearInputDisplay() {
      const inp = document.getElementById(`year-input`);
      if (!inp) return;
      const shown = appState.inputMode === `coptic`
        ? appState.copticYear
        : appState.copticYear + 284;
      inp.value = toEastern(shown);
    }

    function handleYearTyping(rawVal) {
      const statusEl = document.getElementById(`input-status`);
      const num = toWesternNumber(rawVal);
      if (isNaN(num)) {
        if (statusEl) {
          statusEl.className = `status-msg is-error`;
          statusEl.textContent = `أدخل رقماً صحيحاً للسنة بالأرقام العربية أو اللاتينية.`;
        }
        return;
      }

      const targetCoptic = appState.inputMode === `coptic` ? num : (num - 284);
      if (targetCoptic < 1 || targetCoptic > 3000) {
        if (statusEl) {
          statusEl.className = `status-msg is-error`;
          statusEl.textContent = appState.inputMode === `coptic`
            ? `السنة خارج النطاق المسموح (يرجى اختيار سنة شهداء بين ١ و٣٠٠٠).`
            : `السنة خارج النطاق المسموح (يرجى اختيار سنة ميلادية بين ٢٨٥ و٣٢٨٤).`;
        }
        return;
      }

      if (statusEl) {
        statusEl.className = `status-msg`;
        statusEl.textContent = ``;
      }

      appState.copticYear = targetCoptic;
      const inp = document.getElementById(`year-input`);
      if (inp) inp.value = toEastern(num);
      renderAll();
      saveStateSafe();
    }

    function stepYear(delta) {
      const next = Math.min(3000, Math.max(1, appState.copticYear + delta));
      appState.copticYear = next;
      normalizeYearInputDisplay();
      const statusEl = document.getElementById(`input-status`);
      if (statusEl) {
        statusEl.className = `status-msg`;
        statusEl.textContent = ``;
      }
      renderAll();
      saveStateSafe();
    }

