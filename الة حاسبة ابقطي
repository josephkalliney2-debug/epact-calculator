    function convertGregToCoptic() {
      const dayEl = document.getElementById(`conv-g-day`);
      const monEl = document.getElementById(`conv-g-month`);
      const yearEl = document.getElementById(`conv-g-year`);
      const statusEl = document.getElementById(`conv-g-status`);
      const resEl = document.getElementById(`conv-g-result`);
      const metaEl = document.getElementById(`conv-g-meta`);
      if (!dayEl || !monEl || !yearEl || !resEl || !metaEl) return;

      const d = toWesternNumber(dayEl.value);
      const m = parseInt(monEl.value, 10);
      const y = toWesternNumber(yearEl.value);

      if (isNaN(d) || isNaN(y) || y < 285 || y > 3284 || d < 1 || d > 31) {
        if (statusEl) {
          statusEl.className = `status-msg is-error`;
          statusEl.textContent = `يرجى إدخال يوم (١–٣١) وسنة ميلادية صحيحة (٢٨٥–٣٢٨٤).`;
        }
        return;
      }

      const monthDays = [31, isGregorianLeap(y) ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
      if (d > monthDays[m - 1]) {
        if (statusEl) {
          statusEl.className = `status-msg is-error`;
          statusEl.textContent = `شهر ${GREG_MONTHS[m - 1]} ${toEastern(y)} يحتوي على ${toEastern(monthDays[m - 1])} يوماً فقط.`;
        }
        return;
      }

      if (statusEl) {
        statusEl.className = `status-msg`;
        statusEl.textContent = ``;
      }

      appState.convGreg = { day: d, month: m, year: y };
      const jdn = (y < 1582 || (y === 1582 && (m < 10 || (m === 10 && d < 15))))
        ? julianToJdn(y, m, d)
        : gregorianToJdn(y, m, d);
      const c = jdnToCoptic(jdn);
      const wd = WEEKDAYS[jdnWeekdayIndex(jdn)];

      resEl.textContent = `${wd} ${formatCopticDate(c)}`;
      const cLeapTxt = isCopticLeap(c.year) ? `سنة شهداء كبيسة إضافية (٦ أيام نسئ)` : `سنة شهداء بسيطة (٥ أيام نسئ)`;
      const gLeapTxt = isGregorianLeap(y) ? `سنة ميلادية كبيسة` : `سنة ميلادية بسيطة`;
      metaEl.textContent = `${cLeapTxt} • ${gLeapTxt}`;
      saveStateSafe();
    }

    function convertCopticToGreg() {
      const dayEl = document.getElementById(`conv-c-day`);
      const monEl = document.getElementById(`conv-c-month`);
      const yearEl = document.getElementById(`conv-c-year`);
      const statusEl = document.getElementById(`conv-c-status`);
      const resEl = document.getElementById(`conv-c-result`);
      const metaEl = document.getElementById(`conv-c-meta`);
      if (!dayEl || !monEl || !yearEl || !resEl || !metaEl) return;

      const d = toWesternNumber(dayEl.value);
      const m = parseInt(monEl.value, 10);
      const y = toWesternNumber(yearEl.value);

      if (isNaN(d) || isNaN(y) || y < 1 || y > 3000 || d < 1 || d > 30) {
        if (statusEl) {
          statusEl.className = `status-msg is-error`;
          statusEl.textContent = `يرجى إدخال يوم قبطي صحيح وسنة شهداء بين ١ و٣٠٠٠.`;
        }
        return;
      }

      const maxD = m === 13 ? (isCopticLeap(y) ? 6 : 5) : 30;
      if (d > maxD) {
        if (statusEl) {
          statusEl.className = `status-msg is-error`;
          statusEl.textContent = `شهر ${COPTIC_MONTHS[m - 1]} سنة ${toEastern(y)} ش يحتوي على ${toEastern(maxD)} ${maxD === 6 ? `أيام` : `أيام`} فقط.`;
        }
        return;
      }

      if (statusEl) {
        statusEl.className = `status-msg`;
        statusEl.textContent = ``;
      }

      appState.convCoptic = { day: d, month: m, year: y };
      const jdn = copticToJdn(y, m, d);
      const g = jdnToGregorian(jdn);
      const wd = WEEKDAYS[jdnWeekdayIndex(jdn)];

      resEl.textContent = `${wd} ${formatGregDate(g)}`;
      const cLeapTxt = isCopticLeap(y) ? `سنة شهداء كبيسة إضافية (٦ أيام نسئ)` : `سنة شهداء بسيطة (٥ أيام نسئ)`;
      const gLeapTxt = isGregorianLeap(g.year) ? `توافق سنة ميلادية كبيسة` : `توافق سنة ميلادية بسيطة`;
      metaEl.textContent = `${cLeapTxt} • ${gLeapTxt}`;
      saveStateSafe();
    }

