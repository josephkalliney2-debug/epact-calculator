    function copySummaryToClipboard() {
      const data = computeEpactYear(appState.copticYear);
      const report = buildPlainTextReport(data);
      const statusEl = document.getElementById(`input-status`);
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(report).then(function () {
          if (statusEl) {
            statusEl.className = `status-msg is-success`;
            statusEl.textContent = `تم نسخ ملخص حسابات سنة ${toEastern(data.yc)} ش بنجاح.`;
          }
        }).catch(function () {
          if (statusEl) {
            statusEl.className = `status-msg is-error`;
            statusEl.textContent = `تعذر النسخ التلقائي في هذا المتصفح؛ يمكنك استخدام زر تصدير التقرير.`;
          }
        });
      } else if (statusEl) {
        statusEl.className = `status-msg is-error`;
        statusEl.textContent = `النسخ التلقائي غير مدعوم هنا؛ استخدم زر تصدير التقرير السنوي.`;
      }
    }

    function exportYearReport() {
      const data = computeEpactYear(appState.copticYear);
      const report = buildPlainTextReport(data);
      const statusEl = document.getElementById(`input-status`);
      if (window.notebookAppApi && typeof window.notebookAppApi.triggerFileDownload === `function`) {
        window.notebookAppApi.triggerFileDownload({
          content: report,
          contentType: `text/plain`,
          encoding: `UTF-8`,
          filename: `epact_${data.yc}_AM.txt`
        });
        if (statusEl) {
          statusEl.className = `status-msg is-success`;
          statusEl.textContent = `تم تصدير التقرير النصي لسنة ${toEastern(data.yc)} ش.`;
        }
      } else {
        const blob = new Blob([report], { type: `text/plain;charset=utf-8` });
        const url = URL.createObjectURL(blob);
        const a = document.createElement(`a`);
        a.href = url;
        a.download = `epact_${data.yc}_AM.txt`;
        a.click();
        URL.revokeObjectURL(url);
        if (statusEl) {
          statusEl.className = `status-msg is-success`;
          statusEl.textContent = `تم تنزيل التقرير النصي لسنة ${toEastern(data.yc)} ش.`;
        }
      }
    }

    // State Persistence via Gemini Notebook Shim API
    async function saveStateSafe() {
      try {
        if (window.notebookAppApi && typeof window.notebookAppApi.setAppState === `function`) {
          await window.notebookAppApi.setAppState({
            inputMode: appState.inputMode,
            copticYear: appState.copticYear,
            feastFilter: appState.feastFilter,
            convGreg: appState.convGreg,
            convCoptic: appState.convCoptic
          });
        }
      } catch (err) {
        // Ignore persistence errors silently when offline
      }
    }

    async function initApp() {
      populateMonthSelects();

      try {
        if (window.notebookAppApi && typeof window.notebookAppApi.getAppState === `function`) {
          const saved = await window.notebookAppApi.getAppState();
          if (saved && typeof saved === `object`) {
            if (saved.inputMode === `coptic` || saved.inputMode === `gregorian`) {
              appState.inputMode = saved.inputMode;
            }
            if (typeof saved.copticYear === `number` && saved.copticYear >= 1 && saved.copticYear <= 3000) {
              appState.copticYear = saved.copticYear;
            }
            if (typeof saved.feastFilter === `string`) {
              appState.feastFilter = saved.feastFilter;
            }
            if (saved.convGreg && typeof saved.convGreg.year === `number`) {
              appState.convGreg = saved.convGreg;
            }
            if (saved.convCoptic && typeof saved.convCoptic.year === `number`) {
              appState.convCoptic = saved.convCoptic;
            }
          }
        }
      } catch (err) {
        // Use defaults if state fetch fails
      }

      // Apply restored UI values
      setInputMode(appState.inputMode);

      const gDay = document.getElementById(`conv-g-day`);
      const gMon = document.getElementById(`conv-g-month`);
      const gYr = document.getElementById(`conv-g-year`);
      if (gDay) gDay.value = toEastern(appState.convGreg.day);
      if (gMon) gMon.value = String(appState.convGreg.month);
      if (gYr) gYr.value = toEastern(appState.convGreg.year);

      const cDay = document.getElementById(`conv-c-day`);
      const cMon = document.getElementById(`conv-c-month`);
      const cYr = document.getElementById(`conv-c-year`);
      if (cDay) cDay.value = toEastern(appState.convCoptic.day);
      if (cMon) cMon.value = String(appState.convCoptic.month);
      if (cYr) cYr.value = toEastern(appState.convCoptic.year);

      const btns = document.querySelectorAll(`.filter-btn`);
      btns.forEach(function (b) {
        b.classList.toggle(`active`, b.getAttribute(`data-filter`) === appState.feastFilter);
      });

      renderAll();
      convertGregToCoptic();
      convertCopticToGreg();

      if (window.notebookAppApi && typeof window.notebookAppApi.notifyAppReady === `function`) {
        window.notebookAppApi.notifyAppReady();
      }
    }

    document.addEventListener(`DOMContentLoaded`, initApp);
  </script>
</body>
</html>
