  <script>
    const EASTERN_DIGITS = [`٠`, `١`, `٢`, `٣`, `٤`, `٥`, `٦`, `٧`, `٨`, `٩`];

    function toEastern(val) {
      return String(val).replace(/[0-9]/g, function (d) {
        return EASTERN_DIGITS[Number(d)];
      });
    }

    function toWesternNumber(str) {
      const cleaned = String(str)
        .replace(/[٠-٩]/g, function (d) { return String(EASTERN_DIGITS.indexOf(d)); })
        .replace(/[^\d]/g, ``);
      return cleaned === `` ? NaN : parseInt(cleaned, 10);
    }

    const WEEKDAYS = [`الأحد`, `الإثنين`, `الثلاثاء`, `الأربعاء`, `الخميس`, `الجمعة`, `السبت`];

    // Source Table: Sun Epact 1..7 starting from Wednesday
    const SUN_EPACT_DAYS = [
      { epact: 1, name: `الأربعاء`, wd: 3 },
      { epact: 2, name: `الخميس`, wd: 4 },
      { epact: 3, name: `الجمعة`, wd: 5 },
      { epact: 4, name: `السبت`, wd: 6 },
      { epact: 5, name: `الأحد`, wd: 0 },
      { epact: 6, name: `الإثنين`, wd: 1 },
      { epact: 7, name: `الثلاثاء`, wd: 2 }
    ];

    const COPTIC_MONTHS = [
      `توت`, `بابه`, `هاتور`, `كيهك`, `طوبة`, `أمشير`,
      `برمهات`, `برمودة`, `بشنس`, `بؤونة`, `أبيب`, `مسرى`, `النسئ`
    ];

    const GREG_MONTHS = [
      `يناير`, `فبراير`, `مارس`, `أبريل`, `مايو`, `يونيو`,
      `يوليو`, `أغسطس`, `سبتمبر`, `أكتوبر`, `نوفمبر`, `ديسمبر`
    ];

    const METONIC_TABLE = [
      { cycle: 1, epact: 11, passoverDay: 29, passoverMonth: 7 },
      { cycle: 2, epact: 22, passoverDay: 18, passoverMonth: 8 },
      { cycle: 3, epact: 3,  passoverDay: 7,  passoverMonth: 8 },
      { cycle: 4, epact: 14, passoverDay: 26, passoverMonth: 7 },
      { cycle: 5, epact: 25, passoverDay: 15, passoverMonth: 8 },
      { cycle: 6, epact: 6,  passoverDay: 4,  passoverMonth: 8 },
      { cycle: 7, epact: 17, passoverDay: 23, passoverMonth: 8 },
      { cycle: 8, epact: 28, passoverDay: 12, passoverMonth: 8 },
      { cycle: 9, epact: 9,  passoverDay: 1,  passoverMonth: 8 },
      { cycle: 10, epact: 20, passoverDay: 20, passoverMonth: 8 },
      { cycle: 11, epact: 1,  passoverDay: 9,  passoverMonth: 8 },
      { cycle: 12, epact: 12, passoverDay: 28, passoverMonth: 7 },
      { cycle: 13, epact: 23, passoverDay: 17, passoverMonth: 8 },
      { cycle: 14, epact: 4,  passoverDay: 6,  passoverMonth: 8 },
      { cycle: 15, epact: 15, passoverDay: 25, passoverMonth: 7 },
      { cycle: 16, epact: 26, passoverDay: 14, passoverMonth: 8 },
      { cycle: 17, epact: 7,  passoverDay: 3,  passoverMonth: 8 },
      { cycle: 18, epact: 18, passoverDay: 22, passoverMonth: 8 },
      { cycle: 19, epact: 29, passoverDay: 10, passoverMonth: 8 }
    ];

    // App State
    let appState = {
      inputMode: `coptic`,
      copticYear: 1743,
      feastFilter: `all`,
      convGreg: { day: 19, month: 11, year: 2026 },
      convCoptic: { day: 10, month: 3, year: 1743 }
    };

    // Exact JDN Algorithms
    function copticToJdn(y, m, d) {
      const leapDaysBefore = Math.floor(y / 4);
      return 1825030 + (y - 1) * 365 + leapDaysBefore + (m - 1) * 30 + (d - 1);
    }

    function jdnToCoptic(jdn) {
      const daysSinceEpoch = jdn - 1825030;
      const cycle = Math.floor(daysSinceEpoch / 1461);
      const rem = daysSinceEpoch - cycle * 1461;
      let yInCycle = 1;
      let dayOfYear = rem;
      if (rem >= 1096) {
        yInCycle = 4;
        dayOfYear = rem - 1096;
      } else if (rem >= 730) {
        yInCycle = 3;
        dayOfYear = rem - 730;
      } else if (rem >= 365) {
        yInCycle = 2;
        dayOfYear = rem - 365;
      }
      const year = cycle * 4 + yInCycle;
      const month = Math.floor(dayOfYear / 30) + 1;
      const day = (dayOfYear % 30) + 1;
      return { year: year, month: month, day: day };
    }

    function gregorianToJdn(y, m, d) {
      const a = Math.floor((14 - m) / 12);
      const y1 = y + 4800 - a;
      const m1 = m + 12 * a - 3;
      return d + Math.floor((153 * m1 + 2) / 5) + 365 * y1 + Math.floor(y1 / 4) - Math.floor(y1 / 100) + Math.floor(y1 / 400) - 32045;
    }

    function julianToJdn(y, m, d) {
      const a = Math.floor((14 - m) / 12);
      const y1 = y + 4800 - a;
      const m1 = m + 12 * a - 3;
      return d + Math.floor((153 * m1 + 2) / 5) + 365 * y1 + Math.floor(y1 / 4) - 32083;
    }

    function jdnToGregorian(jdn) {
      // Pre-Oct 15, 1582 (JDN < 2299161): convert as Julian calendar for historical accuracy
      if (jdn < 2299161) {
        const b = 0;
        const c = jdn + 32082;
        const d = Math.floor((4 * c + 3) / 1461);
        const e = c - Math.floor((1461 * d) / 4);
        const m = Math.floor((5 * e + 2) / 153);
        const day = e - Math.floor((153 * m + 2) / 5) + 1;
        const month = m + 3 - 12 * Math.floor(m / 10);
        const year = 100 * b + d - 4800 + Math.floor(m / 10);
        return { year: year, month: month, day: day, isJulian: true };
      }
      const a = jdn + 32044;
      const b = Math.floor((4 * a + 3) / 146097);
      const c = a - Math.floor((146097 * b) / 4);
      const d = Math.floor((4 * c + 3) / 1461);
      const e = c - Math.floor((1461 * d) / 4);
      const m = Math.floor((5 * e + 2) / 153);
      const day = e - Math.floor((153 * m + 2) / 5) + 1;
      const month = m + 3 - 12 * Math.floor(m / 10);
      const year = 100 * b + d - 4800 + Math.floor(m / 10);
      return { year: year, month: month, day: day, isJulian: false };
    }

    function jdnWeekdayIndex(jdn) {
      // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
      return (jdn + 1) % 7;
    }

    function isCopticLeap(yc) {
      return (yc % 4) === 3;
    }

    function isGregorianLeap(yg) {
      if (yg <= 1582) return (yg % 4) === 0;
      return (yg % 4 === 0 && yg % 100 !== 0) || (yg % 400 === 0);
    }

    function formatCopticDate(c) {
      return `${toEastern(c.day)} ${COPTIC_MONTHS[c.month - 1]} ${toEastern(c.year)} ش`;
    }

    function formatCopticShort(c) {
      return `${toEastern(c.day)} ${COPTIC_MONTHS[c.month - 1]}`;
    }

    function formatGregDate(g) {
      const calTag = g.isJulian ? ` م (يولياني)` : ` م`;
      return `${toEastern(g.day)} ${GREG_MONTHS[g.month - 1]} ${toEastern(g.year)}${calTag}`;
    }

    function computeEpactYear(yc) {
      // 1. Sun Cycle & Epact
      const sunMinus4 = yc - 4;
      let sunCycle = ((sunMinus4 % 28) + 28) % 28;
      if (sunCycle === 0) sunCycle = 28;
      const sunQuarter = Math.floor(sunCycle / 4);
      const sunSum = sunCycle + sunQuarter;
      let sunEpact = sunSum % 7;
      if (sunEpact === 0) sunEpact = 7;

      const startDayObj = SUN_EPACT_DAYS[sunEpact - 1];
      const startWd = startDayObj.wd; // 0=Sunday .. 6=Saturday

      // 2. Moon Cycle & Epact
      const moonMinus1 = yc - 1;
      let moonCycle = ((moonMinus1 % 19) + 19) % 19;
      if (moonCycle === 0) moonCycle = 19;

      const gregEasterYear = yc + 284;
      let moonCycleGreg = gregEasterYear % 19;
      if (moonCycleGreg === 0) moonCycleGreg = 19;

      const moonTimes11 = moonCycle * 11;
      const moonEpact = moonTimes11 % 30;

      // 3. Passover (14 Nisan)
      const rawSub = 40 - moonEpact;
      const metonicRow = METONIC_TABLE[moonCycle - 1];
      const passoverMonth = metonicRow.passoverMonth;
      const passoverDay = metonicRow.passoverDay;

      const passoverJdn = copticToJdn(yc, passoverMonth, passoverDay);
      const passoverWd = jdnWeekdayIndex(passoverJdn);

      // 4. Easter Sunday (Next Sunday strictly after Passover)
      let daysAfterPassover = (7 - passoverWd) % 7;
      if (daysAfterPassover === 0) daysAfterPassover = 7;
      const easterJdn = passoverJdn + daysAfterPassover;
      const easterCoptic = jdnToCoptic(easterJdn);
      const easterGreg = jdnToGregorian(easterJdn);

      // 5. Christmas & Epiphany in this Coptic year
      // Rule from lecture: when yc % 4 === 0 (the Coptic year whose Jan precedes Feb 29 of a Gregorian leap year),
      // Jan 7 is 28 Koiak and Jan 19 is 10 Toba; otherwise Jan 7 is 29 Koiak and Jan 19 is 11 Toba.
      const isPostLeapCoptic = (yc % 4) === 0;
      const xmasDay = isPostLeapCoptic ? 28 : 29;
      const epiphanyDay = isPostLeapCoptic ? 10 : 11;
      const xmasJdn = copticToJdn(yc, 4, xmasDay);

      // Source formula for Rifa' Al-Milad (days from Christmas to Great Lent)
      const rifaNativityDays = easterCoptic.month === 8
        ? easterCoptic.day + 36
        : easterCoptic.day + 6;

      // Movable Feasts & Fasts JDN offsets
      const jonahRifaJdn = easterJdn - 70;
      const jonahStartJdn = easterJdn - 69;
      const jonahEndJdn = easterJdn - 67;
      const jonahPassoverJdn = easterJdn - 66;
      const lentRifaJdn = easterJdn - 56;
      const lentStartJdn = easterJdn - 55;
      const lentLastFriJdn = easterJdn - 9;
      const lazarusSatJdn = easterJdn - 8;
      const palmSunJdn = easterJdn - 7;
      const covenantThuJdn = easterJdn - 3;
      const goodFriJdn = easterJdn - 2;
      const brightSatJdn = easterJdn - 1;
      const thomasSunJdn = easterJdn + 7;
      const ascensionJdn = easterJdn + 39;
      const pentecostJdn = easterJdn + 49;
      const apostlesStartJdn = easterJdn + 50;
      const apostlesFeastJdn = copticToJdn(yc, 11, 5); // 5 Abib

      // Apostles' fast length formula from source
      const apostlesFastDays = easterCoptic.month === 7
        ? (30 - easterCoptic.day) + 45
        : (30 - easterCoptic.day) + 15;

      const nyJdn = copticToJdn(yc, 1, 1);
      const nyGreg = jdnToGregorian(nyJdn);

      return {
        yc: yc,
        gregEasterYear: gregEasterYear,
        isCopticLeapYear: isCopticLeap(yc),
        isGregEasterLeapYear: isGregorianLeap(gregEasterYear),
        isPostLeapCoptic: isPostLeapCoptic,
        sunMinus4: sunMinus4,
        sunCycle: sunCycle,
        sunQuarter: sunQuarter,
        sunSum: sunSum,
        sunEpact: sunEpact,
        startDayName: startDayObj.name,
        startWd: startWd,
        nyJdn: nyJdn,
        nyGreg: nyGreg,
        moonMinus1: moonMinus1,
        moonCycle: moonCycle,
        moonCycleGreg: moonCycleGreg,
        moonTimes11: moonTimes11,
        moonEpact: moonEpact,
        rawSub: rawSub,
        passoverMonth: passoverMonth,
        passoverDay: passoverDay,
        passoverJdn: passoverJdn,
        passoverWd: passoverWd,
        daysAfterPassover: daysAfterPassover,
        easterJdn: easterJdn,
        easterCoptic: easterCoptic,
        easterGreg: easterGreg,
        xmasDay: xmasDay,
        epiphanyDay: epiphanyDay,
        xmasJdn: xmasJdn,
        rifaNativityDays: rifaNativityDays,
        apostlesFastDays: apostlesFastDays,
        movable: {
          jonahRifaJdn: jonahRifaJdn,
          jonahStartJdn: jonahStartJdn,
          jonahEndJdn: jonahEndJdn,
          jonahPassoverJdn: jonahPassoverJdn,
          lentRifaJdn: lentRifaJdn,
          lentStartJdn: lentStartJdn,
          lentLastFriJdn: lentLastFriJdn,
          lazarusSatJdn: lazarusSatJdn,
          palmSunJdn: palmSunJdn,
          covenantThuJdn: covenantThuJdn,
          goodFriJdn: goodFriJdn,
          brightSatJdn: brightSatJdn,
          easterJdn: easterJdn,
          thomasSunJdn: thomasSunJdn,
          ascensionJdn: ascensionJdn,
          pentecostJdn: pentecostJdn,
          apostlesStartJdn: apostlesStartJdn,
          apostlesFeastJdn: apostlesFeastJdn
        }
      };
    }

    function renderAll() {
      const data = computeEpactYear(appState.copticYear);
      renderHeadlineFigures(data);
      renderSteps(data);
      renderMonthsTable(data);
      renderMetonicTable(data);
